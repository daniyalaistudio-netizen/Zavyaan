PORT=5000
NODE_ENV=development

# Leave empty to use the local JSON store (server/data/store.json).
# For PostgreSQL (Neon, Render, Supabase, local Docker):
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# Admin sign-in (change these before going live)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# Optional: signs admin session tokens (any long random string). If unset it is derived from the password.
SESSION_SECRET=
# Optional: sign out the admin after this many idle minutes (default 30)
ADMIN_IDLE_MINUTES=30

# Optional: PUBLIC_DEMO=true makes management read-only for everyone except localhost
PUBLIC_DEMO=false
